# Choose "llm" or "rule_based". The app uses rule_based if vLLM is unavailable.
PLANNER_MODE=llm

# OpenAI-compatible vLLM API endpoint and the model name served by vLLM.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=

# Optional. Leave blank for a local endpoint without API-key authentication.
VLLM_API_KEY=
VLLM_TIMEOUT_SECONDS=45
